# Copy to .env.local for local dev.
# These vars are read SERVER-SIDE ONLY. Never expose them with NEXT_PUBLIC_.

# Bot API (the FastAPI service this dashboard talks to). For local dev with
# the docker-compose mock, leave these as the defaults.
HTA_API_URL=http://127.0.0.1:8080
HTA_API_TOKEN=local-dev-token-do-not-use-in-prod

# NextAuth credentials provider config. Set NEXTAUTH_SECRET to a long random
# string in prod; the operator password is sha256-hashed in this env.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-me-in-prod-with-openssl-rand-base64-32
# sha256 of the password the operator types. Generate with:
#   echo -n "your-password" | shasum -a 256 | awk '{print $1}'
DASHBOARD_PASSWORD_SHA256=06e55b633481f7bb072957eabcf110c972e86691c3cfedabe088024bffe42f23
